pragma solidity ^0.8.20;

import "./IssuerRegistry.sol";

/// @notice Public credential status registry. Only opaque bytes32 fingerprints
///         and issuer/status metadata are persisted on-chain.
contract CredentialRegistry {
    IssuerRegistry public immutable issuerRegistry;

    struct CredentialStatus {
        address issuer;
        uint64 issuedAt;
        uint64 revokedAt;
        bool exists;
    }

    mapping(bytes32 => CredentialStatus) private credentials;

    event CredentialRegistered(bytes32 indexed fingerprint, address indexed issuer, uint64 issuedAt);
    event CredentialRevoked(bytes32 indexed fingerprint, address indexed issuer, uint64 revokedAt);

    error IssuerNotAuthorized();
    error CredentialAlreadyExists();
    error CredentialNotFound();
    error CredentialAlreadyRevoked();
    error EmptyFingerprint();

    constructor(address issuerRegistryAddress) {
        issuerRegistry = IssuerRegistry(issuerRegistryAddress);
    }

    function registerCredential(bytes32 fingerprint) external {
        if (!issuerRegistry.isIssuer(msg.sender)) revert IssuerNotAuthorized();
        if (fingerprint == bytes32(0)) revert EmptyFingerprint();
        if (credentials[fingerprint].exists) revert CredentialAlreadyExists();

        uint64 issued = uint64(block.timestamp);
        credentials[fingerprint] = CredentialStatus(msg.sender, issued, 0, true);
        emit CredentialRegistered(fingerprint, msg.sender, issued);
    }

    function revokeCredential(bytes32 fingerprint) external {
        CredentialStatus storage credential = credentials[fingerprint];
        if (!credential.exists) revert CredentialNotFound();
        if (credential.issuer != msg.sender || !issuerRegistry.isIssuer(msg.sender)) revert IssuerNotAuthorized();
        if (credential.revokedAt != 0) revert CredentialAlreadyRevoked();

        uint64 revoked = uint64(block.timestamp);
        credential.revokedAt = revoked;
        emit CredentialRevoked(fingerprint, msg.sender, revoked);
    }

    function getCredential(bytes32 fingerprint) external view returns (CredentialStatus memory) {
        return credentials[fingerprint];
    }

    function isValid(bytes32 fingerprint) external view returns (bool) {
        CredentialStatus storage credential = credentials[fingerprint];
        return credential.exists && credential.revokedAt == 0 && issuerRegistry.isIssuer(credential.issuer);
    }
}
